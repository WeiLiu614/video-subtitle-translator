# Copy this file to .env and fill in at least one LLM provider API key.

# --- OpenAI (default: gpt-6-luna — newest cheapest GPT-6 model) ---
# Also works with OpenAI-compatible APIs (DeepSeek, OpenRouter, SiliconFlow, Ollama, etc.)
OPENAI_API_KEY=
# Optional custom base URL for OpenAI-compatible endpoints, e.g.:
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_BASE_URL=

# --- Google Gemini (optional alternative) ---
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Optional Default Settings ---
# SUBGEN_ASR_BACKEND=auto          # auto | mlx | faster-whisper | openvino
# SUBGEN_WHISPER_MODEL=auto        # auto (hardware-selected) | large-v3-turbo | large-v3 | large-v3-turbo-int4 | medium | small | base
# SUBGEN_MODEL_CACHE_DIR=          # Optional custom directory for cached Whisper models (e.g. /Volumes/Lexar/translator/.subgen_models)
# SUBGEN_TRANSLATOR=openai         # openai | gemini
# SUBGEN_OPENAI_MODEL=gpt-6-luna         # newest cheapest GPT-6 ($0.10/1M in, $0.50/1M out); or gpt-6.2-sol / gpt-5-nano
# SUBGEN_GEMINI_MODEL=gemini-4-hydrogen  # newest fast Gemini 4 ($1.50/1M in, $7.50/1M out); budget alt: gemini-3.5-flash-lite ($0.30/$2.50)
